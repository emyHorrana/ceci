# Supabase Configuration (Frontend)
# Chave pública do Supabase usada no frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API Configuration (Frontend)
# URL base do backend Express (rotas /api/licao, /api/usuario, etc.).
# Em desenvolvimento local, use: http://localhost:3001/api
# Em produção (ex: Vercel com serverless /api), deixe em branco para usar /api
VITE_API_URL=http://localhost:3001/api