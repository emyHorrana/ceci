# Supabase Configuration (Frontend)
# Chave pública do Supabase usada no frontend.
# A segurança deve ser garantida via RLS e policies no Supabase.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API Configuration (Frontend)
# URL base do backend (server/index.js). Sem isso, cai no fallback
# http://localhost:3001/api (ver src/services/api.js).
VITE_API_URL=http://localhost:3001/api