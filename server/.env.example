SUPABASE_URL=
SUPABASE_ANON_KEY=
# Obrigatória: server/lib/supabaseClient.js usa essa chave (não a anon)
# pra gravar nas tabelas sem esbarrar em RLS - copie em
# Project Settings > API > service_role, no painel do Supabase.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Domínio de PRODUÇÃO do frontend (origem permitida no CORS), com https e sem barra final.
# Ex: https://ceci.vercel.app ou https://www.seudominio.com.br
# Obrigatória em produção se o site usar domínio próprio. Sem ela, os POSTs
# do navegador recebem 403 (CORS). Na Vercel, os domínios *.vercel.app deste
# projeto já entram sozinhos pelas variáveis de sistema VERCEL_URL etc.
CLIENT_URL=
# Opcional (padrão: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite